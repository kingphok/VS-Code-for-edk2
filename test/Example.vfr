//==============================================================================
//
//  ## @file
//  Syntax Extension Test VFR File for EDK II v1.92.
//
//==============================================================================

#include "CustomDriverData.h"

#define FORMSET_GUID      { 0x12345678, 0x1234, 0x1234, { 0x12, 0x34, 0x56, 0x78, 0x9A, 0xBC, 0xDE, 0xF0 } }
#define CONFIG_VARSTORE_ID 0x1000

#define FLAG_PRODUCTION    1
#define FLAG_DEBUG         0

#pragma pack(1)
typedef struct {
  UINT8   BootStore;
  UINT16  TimeoutValue;
  BOOLEAN FastBootEnable;
  UINT32  UserSecurityKey;
  UINT8   OrderedPr;
  UINT8   StringBuf;
  EFI_HII_DATE MyDate;
  EFI_HII_TIME MyTime;
} MY_DRIVER_CONFIGURATION;
#pragma pack()

formset
  guid      = FORMSET_GUID,
  title     = STRING_TOKEN(STR_FORMSET_TITLE),
  help      = STRING_TOKEN(STR_FORMSET_HELP),
  classguid = EFI_HII_SETTING_ACCESS_GUID,
  class     = NON_DEVICE,
  subclass  = SETUP_APPLICATION;

  defaultstore MyStandard, prompt = STRING_TOKEN(STR_STANDARD_DEFAULT), attribute = 0x0000;
  defaultstore MyManufacturing, prompt = STRING_TOKEN(STR_MFG_DEFAULT), attribute = 0x0001;

  varstore MY_DRIVER_CONFIGURATION,
    varid = CONFIG_VARSTORE_ID,
    name  = MyConfig,
    guid  = FORMSET_GUID;

  efivarstore MY_DRIVER_CONFIGURATION,
    attribute = EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_NON_VOLATILE,
    name  = MyEfiConfig,
    guid  = FORMSET_GUID;

  form formid = 1,
    title = STRING_TOKEN(STR_FORM_TITLE);

    subtitle text = STRING_TOKEN(STR_SUBTITLE_TEXT), flags = HORIZONTAL_DIVIDER;

    text
      help   = STRING_TOKEN(STR_TEXT_HELP),
      text   = STRING_TOKEN(STR_TEXT_PROMPT),
      text   = STRING_TOKEN(STR_TEXT_VALUE),
      flags  = 0,
      key    = 0x100;

    label 0x1000;
    label 0x1001;

#if FLAG_PRODUCTION == 1
    checkbox varid = MyConfig.FastBootEnable,
      prompt   = STRING_TOKEN(STR_CHECKBOX_PROMPT_PROD),
      help     = STRING_TOKEN(STR_CHECKBOX_HELP_PROD),
      flags    = CHECKBOX_DEFAULT | RESET_REQUIRED,
      key      = 0x101,
    endcheckbox;
#elif FLAG_DEBUG == 1
    checkbox varid = MyConfig.FastBootEnable,
      prompt   = STRING_TOKEN(STR_CHECKBOX_PROMPT_DEBUG),
      help     = STRING_TOKEN(STR_CHECKBOX_HELP_DEBUG),
      flags    = CHECKBOX_DEFAULT | INTERACTIVE,
      key      = 0x101,
    endcheckbox;
#else
    checkbox varid = MyConfig.FastBootEnable,
      prompt   = STRING_TOKEN(STR_CHECKBOX_PROMPT_DEFAULT),
      help     = STRING_TOKEN(STR_CHECKBOX_HELP_DEFAULT),
      flags    = CHECKBOX_DEFAULT,
      key      = 0x101,
    endcheckbox;
#endif

    numeric varid = MyConfig.TimeoutValue,
      prompt  = STRING_TOKEN(STR_NUMERIC_PROMPT),
      help    = STRING_TOKEN(STR_NUMERIC_HELP),
      flags   = DISPLAY_UINT_DEC | OPTIONS_ONLY,
      minimum = 0,
      maximum = 60,
      step    = 1,
      default = 10, defaultstore = MyStandard,
    endnumeric;

    oneof varid = MyConfig.BootStore,
      prompt      = STRING_TOKEN(STR_ONEOF_PROMPT),
      help        = STRING_TOKEN(STR_ONEOF_HELP),
      flags       = 0,
      option text = STRING_TOKEN(STR_OPTION_1), value = 1, flags = DEFAULT;
      option text = STRING_TOKEN(STR_OPTION_2), value = 2, flags = 0;
    endoneof;

    orderedlist varid = MyConfig.OrderedPr,
      prompt  = STRING_TOKEN(STR_ORDERED_PROMPT),
      help    = STRING_TOKEN(STR_ORDERED_HELP),
      flags   = 0,
      option text = STRING_TOKEN(STR_ORD_1), value = 1, flags = 0;
      option text = STRING_TOKEN(STR_ORD_2), value = 2, flags = 0;
    endorderedlist;

    string varid = MyConfig.StringBuf,
      prompt  = STRING_TOKEN(STR_STRING_PROMPT),
      help    = STRING_TOKEN(STR_STRING_HELP),
      flags   = INTERACTIVE,
      key     = 0x102,
      minsize = 5,
      maxsize = 10,
    endstring;

    date varid = MyConfig.MyDate,
      prompt  = STRING_TOKEN(STR_DATE_PROMPT),
      help    = STRING_TOKEN(STR_DATE_HELP),
      flags   = Q_DATE_YEAR_MONTH_DAY,
    enddate;

    time varid = MyConfig.MyTime,
      prompt  = STRING_TOKEN(STR_TIME_PROMPT),
      help    = STRING_TOKEN(STR_TIME_HELP),
      flags   = Q_TIME_HOUR_MINUTE_SECOND,
    endtime;

    goto 2,
      prompt = STRING_TOKEN(STR_GOTO_PROMPT),
      help   = STRING_TOKEN(STR_GOTO_HELP),
      flags  = INTERACTIVE,
      key    = 0x103;

    image
      imageid = 0x01,
    endimage;

    animation
      animationid = 0x02,
    endanimation;

    banner
      title = STRING_TOKEN(STR_BANNER_TITLE),
      line  = 1,
      align = LEFT,
    endbanner;

    password varid = MyConfig.UserSecurityKey,
      prompt  = STRING_TOKEN(STR_PASSWORD_PROMPT),
      help    = STRING_TOKEN(STR_PASSWORD_HELP),
      flags   = 0,
      minsize = 4,
      maxsize = 8,
    endpassword;

    resetbutton
      prompt = STRING_TOKEN(STR_RESET_PROMPT),
      help   = STRING_TOKEN(STR_RESET_HELP),
    endresetbutton;

    disableif ideqval MyConfig.FastBootEnable == 0;
      grayoutif ideqval MyConfig.TimeoutValue == 10;
        suppressif ideqval MyConfig.BootStore == 1;
          
          numeric varid = MyConfig.BootStore,
            prompt  = STRING_TOKEN(STR_NESTED_PROMPT),
            help    = STRING_TOKEN(STR_NESTED_HELP),
            minimum = 1,
            maximum = 4,
          endnumeric;

        endif;
      endif;
    endif;

    disableif (ideqval MyConfig.TimeoutValue == 0) OR 
              (ideqval MyConfig.TimeoutValue != 5) AND 
              NOT (ideqval MyConfig.BootStore > 1) OR 
              (ideqval MyConfig.BootStore < 4) OR 
              (ideqval MyConfig.BootStore >= 2) OR 
              (ideqval MyConfig.BootStore <= 3);
              
      text
        help   = STRING_TOKEN(STR_TEXT_HELP),
        text   = STRING_TOKEN(STR_TEXT_PROMPT);
    endif;

    disableif (ideqval MyConfig.TimeoutValue + 1 == 2) OR 
              (ideqval MyConfig.TimeoutValue - 1 == 0) OR 
              (ideqval MyConfig.TimeoutValue * 2 == 20) OR 
              (ideqval MyConfig.TimeoutValue / 2 == 5) OR 
              (ideqval MyConfig.TimeoutValue % 3 == 1) OR 
              ((ideqval MyConfig.TimeoutValue & 1) == 0) OR 
              ((ideqval MyConfig.TimeoutValue | 2) == 10) OR 
              ((ideqval MyConfig.TimeoutValue ^ 3) == 9) OR 
              (~ideqval MyConfig.TimeoutValue == 0);
              
      text
        help   = STRING_TOKEN(STR_TEXT_HELP),
        text   = STRING_TOKEN(STR_TEXT_PROMPT);
    endif;

    disableif (ideqval MyConfig.TimeoutValue << 1 == 20) OR 
              (ideqval MyConfig.TimeoutValue >> 1 == 5) OR
              ideqval MyConfig.FastBootEnable ? TRUE : FALSE;
              
      text
        help   = STRING_TOKEN(STR_TEXT_HELP),
        text   = STRING_TOKEN(STR_TEXT_PROMPT);
    endif;

    rule MyRule, 1 + 2 == 3 endrule;

  endform;

  form formid = 2,
    title = STRING_TOKEN(STR_FORM_2_TITLE);

    text
      help   = STRING_TOKEN(STR_COND_HELP),
      text   = STRING_TOKEN(STR_COND_PROMPT),
      text   = STRING_TOKEN(STR_COND_VALUE),
      flags  = cond(ideqval MyConfig.TimeoutValue == 10 ? 1 : 0);

  endform;

endformset;
