{
  "name": "EDK2 INF",
  "scopeName": "source.edk2inf",
  "fileTypes": [
    "inf"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#section"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.edk2inf",
          "match": "#.*$"
        }
      ]
    },
    "section": {
      "patterns": [
        {
          "name": "entity.name.section.edk2inf",
          "match": "^\\s*\\[[a-zA-Z0-9_,\\.\\| ]+\\]"
        }
      ]
    }
  }
}
