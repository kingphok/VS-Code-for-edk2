{
  "name": "EDK2 INF",
  "scopeName": "source.edk2inf",
  "fileTypes": [
    "inf"
  ],
  "patterns": [
    {
      "include": "source.edk2cmn#Comment"
    },
    {
      "include": "#EDK_II_INF"
    }
  ],
  "repository": {
    "EDK_II_INF": {
      "patterns": [
        {
          "begin": "^[ \\t]*\\[(?i:(Defines))\\]",
          "end": "(?=^[ \\t]*\\[)",
          "name": "entity.name.section.edk2inf",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#DefineStatements"
            },
            {
              "include": "source.edk2cmn#MacroDefinition"
            },
            {
              "include": "source.edk2cmn#MACROVAL"
            }
          ]
        },
        {
          "begin": "^[ \\t]*\\[(?i:(BuildOptions))\\b",
          "end": "(?=^[ \\t]*\\[)",
          "name": "entity.name.section.edk2inf",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#section_dot_rule"
            },
            {
              "include": "source.edk2cmn#MacroDefinition"
            },
            {
              "include": "source.edk2cmn#MACROVAL"
            },
            {
              "include": "source.edk2cmn#compiler_flag"
            }
          ]
        },
        {
          "begin": "^[ \\t]*\\[(?i:(LibraryClasses))\\b",
          "end": "(?=^[ \\t]*\\[)",
          "name": "entity.name.section.edk2inf",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#section_dot_rule"
            },
            {
              "include": "source.edk2cmn#MacroDefinition"
            },
            {
              "include": "source.edk2cmn#MACROVAL"
            },
            {
              "include": "source.edk2cmn#boolean_expression"
            },
            {
              "include": "source.edk2cmn#FieldSeparator"
            }
          ]
        },
        {
          "begin": "^[ \\t]*\\[(?i:(Packages))\\b",
          "end": "(?=^[ \\t]*\\[)",
          "name": "entity.name.section.edk2inf",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#section_dot_rule"
            },
            {
              "include": "source.edk2cmn#MacroDefinition"
            },
            {
              "include": "source.edk2cmn#MACROVAL"
            },
            {
              "include": "source.edk2cmn#boolean_expression"
            },
            {
              "include": "source.edk2cmn#FieldSeparator"
            }
          ]
        },
        {
          "begin": "^[ \\t]*\\[(?i:(PatchPcd|PcdEx|FeaturePcd|FixedPcd|Pcd))\\b",
          "end": "(?=^[ \\t]*\\[)",
          "name": "entity.name.section.edk2inf",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#section_dot_rule"
            },
            {
              "include": "source.edk2cmn#PcdName_PcdFieldName"
            },
            {
              "include": "source.edk2cmn#MACROVAL"
            },
            {
              "include": "source.edk2cmn#boolean_expression"
            },
            {
              "include": "source.edk2cmn#hex_numbers"
            },
            {
              "include": "source.edk2cmn#decimal_numbers"
            },
            {
              "include": "source.edk2cmn#string_expression"
            },
            {
              "include": "source.edk2cmn#FieldSeparator"
            }
          ]
        },
        {
          "begin": "^[ \\t]*\\[(?i:(Sources))\\b",
          "end": "(?=^[ \\t]*\\[)",
          "name": "entity.name.section.edk2inf",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "begin": "\\|(?![^#\\n]*\\|)[ \\t]*",
              "end": "$",
              "patterns": [
                {
                  "include": "source.edk2cmn#Comment"
                },
                {
                  "include": "source.edk2cmn#MACROVAL"
                },
                {
                  "include": "source.edk2cmn#boolean_expression"
                },
                {
                  "include": "source.edk2cmn#PcdName_PcdFieldName"
                }
              ]
            },
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#section_dot_rule"
            },
            {
              "include": "source.edk2cmn#MacroDefinition"
            },
            {
              "include": "source.edk2cmn#MACROVAL"
            }
          ]
        },
        {
          "begin": "^[ \\t]*\\[(?i:(UserExtensions))\\b",
          "end": "(?=^[ \\t]*\\[)",
          "name": "entity.name.section.edk2inf",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#section_dot_rule"
            }
          ]
        },
        {
          "begin": "^[ \\t]*\\[(?i:(Protocols|Ppis|Guids))\\b",
          "end": "(?=^[ \\t]*\\[)",
          "name": "entity.name.section.edk2inf",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#section_dot_rule"
            },
            {
              "include": "source.edk2cmn#MacroDefinition"
            },
            {
              "include": "source.edk2cmn#MACROVAL"
            },
            {
              "include": "source.edk2cmn#boolean_expression"
            },
            {
              "include": "source.edk2cmn#PcdName_PcdFieldName"
            },
            {
              "include": "source.edk2cmn#FieldSeparator"
            }
          ]
        },
        {
          "begin": "^[ \\t]*\\[(?i:(Depex))\\b",
          "end": "(?=^[ \\t]*\\[)",
          "name": "entity.name.section.edk2inf",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#section_dot_rule"
            },
            {
              "match": "\\b(BEFORE|AFTER|PUSH|SOR|NOT|AND|OR|TRUE|FALSE|END)\\b",
              "name": "keyword.operator.edk2inf"
            }
          ]
        },
        {
          "begin": "^[ \\t]*\\[(?i:(Binaries))\\b",
          "end": "(?=^[ \\t]*\\[)",
          "name": "entity.name.section.edk2inf",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#section_dot_rule"
            },
            {
              "include": "source.edk2cmn#MacroDefinition"
            },
            {
              "include": "source.edk2cmn#MACROVAL"
            },
            {
              "include": "source.edk2cmn#RegistryFormatGUID"
            },
            {
              "match": "\\b(UNI_UI|UI|UNI_VER|VER|ACPI|ASL|PE32|PIC|FV|PEI_DEPEX|DXE_DEPEX|SMM_DEPEX|TE|BIN|RAW|COMPAT16|DISPOSABLE|LIB|SUBTYPE_GUID)\\b",
              "name": "keyword.control.edk2inf"
            },
            {
              "include": "source.edk2cmn#boolean_expression"
            },
            {
              "include": "source.edk2cmn#FieldSeparator"
            }
          ]
        }
      ]
    },
    "section_dot_rule": {
      "begin": "\\G",
      "end": "\\]",
      "patterns": [
        {
          "match": "(?i:\\b(BuildOptions|LibraryClasses|Packages|Sources|UserExtensions|Protocols|Ppis|Guids|Depex|Binaries)\\b)",
          "name": "keyword.control.edk2inf"
        },
        {
          "match": "\\.[ \\t]+|\\.(?=\\])",
          "name": "invalid.illegal.whitespace.edk2inf"
        },
        {
          "match": "\\.",
          "name": "punctuation.separator.dot.edk2inf"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.edk2inf"
        },
        {
          "match": "(?<=[.|])[a-zA-Z0-9_]+\\b",
          "name": "variable.parameter.edk2inf"
        },
        {
          "match": "\"[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*\"",
          "name": "string.quoted.double.edk2inf"
        },
        {
          "include": "source.edk2cmn#FieldSeparator"
        }
      ]
    },
    "DefineStatements": {
      "patterns": [
        {
          "begin": "^[ \\t]*(ENTRY_POINT|UNLOAD_IMAGE|CONSTRUCTOR|DESTRUCTOR)[ \\t]*=",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "name": "entity.name.function.edk2inf",
              "match": "\\b[a-zA-Z0-9_]+\\b"
            },
            {
              "include": "source.edk2cmn#Comment"
            }
          ]
        },
        {
          "begin": "^[ \\t]*(INF_VERSION|BASE_NAME|FILE_GUID|MODULE_TYPE|UEFI_SPECIFICATION_VERSION|PI_SPECIFICATION_VERSION|LIBRARY_CLASS|BUILD_NUMBER|VERSION_STRING|PCD_IS_DRIVER|SHADOW|CUSTOM_MAKEFILE|DPX_SOURCE|SPEC|MODULE_UNI_FILE|UEFI_HII_RESOURCE_SECTION|PEI_PCD_DRIVER|DXE_PCD_DRIVER|PCI_VENDOR_ID|PCI_DEVICE_ID|PCI_CLASS_CODE|PCI_REVISION|PCI_COMPRESS|EDK_RELEASE_VERSION)[ \\t]*=",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "source.edk2cmn#Comment"
            },
            {
              "include": "#ModuleType"
            },
            {
              "include": "source.edk2cmn#MACROVAL"
            },
            {
              "include": "source.edk2cmn#boolean_expression"
            },
            {
              "include": "source.edk2cmn#hex_numbers"
            },
            {
              "include": "source.edk2cmn#decimal_numbers"
            },
            {
              "include": "source.edk2cmn#RegistryFormatGUID"
            },
            {
              "include": "source.edk2cmn#string_expression"
            },
            {
              "include": "source.edk2cmn#version_expression"
            },
            {
              "include": "source.edk2cmn#operators_operands"
            },
            {
              "include": "source.edk2cmn#FieldSeparator"
            }
          ]
        }
      ]
    },
    "ModuleType": {
      "match": "\\b(BASE|SEC|PEI_CORE|PEIM|DXE_CORE|DXE_DRIVER|SMM_CORE|DXE_RUNTIME_DRIVER|DXE_SAL_DRIVER|DXE_SMM_DRIVER|UEFI_DRIVER|UEFI_APPLICATION|USER_DEFINED|HOST_APPLICATION)\\b",
      "name": "variable.other.constant.edk2inf"
    }
  }
}
