{
  "name": "EDK2 INF",
  "scopeName": "source.edk2inf",
  "fileTypes": [
    "inf"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#Section"
    },
    {
      "include": "#define_statements"
    },
    {
      "include": "#macro"
    },
    {
      "include": "#moduleType"
    },
    {
      "include": "#binary_file_type"
    },
    {
      "include": "#constants_and_data"
    },
    {
      "include": "#compiler_flag"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.edk2inf",
          "match": "#.*$"
        }
      ]
    },
    "Section": {
      "patterns": [
        {
          "name": "entity.name.section.edk2inf",
          "begin": "^[ \\t]*(\\[)",
          "end": "(\\])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.section.begin.edk2inf"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.section.end.edk2inf"
            }
          },
          "patterns": [
            {
              "name": "invalid.illegal.whitespace.edk2inf",
              "match": "\\.[ \\t]+"
            },
            {
              "name": "punctuation.separator.dot.edk2inf",
              "match": "\\."
            },
            {
              "name": "keyword.control.edk2inf",
              "match": "\\b(Defines|BuildOptions|LibraryClasses|Packages|FixedPcd|FeaturePcd|PatchPcd|Pcd|PcdEx|Sources|Protocols|Ppis|Guids|Binaries|Depex|UserExtensions)\\b"
            },
            {
              "name": "string.quoted.double.edk2inf",
              "match": "\"[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*\""
            },
            {
              "name": "punctuation.separator.comma.edk2inf",
              "match": ",[ \\t]*"
            },
            {
              "name": "variable.parameter.edk2inf",
              "match": "\\b[a-zA-Z0-9_]+\\b"
            }
          ]
        }
      ]
    },
    "define_statements": {
      "patterns": [
        {
          "begin": "^[ \\t]*(ENTRY_POINT|UNLOAD_IMAGE|CONSTRUCTOR|DESTRUCTOR)[ \\t]*(=)[ \\t]*",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            },
            "2": {
              "name": "punctuation.separator.equals.edk2inf"
            }
          },
          "patterns": [
            {
              "name": "entity.name.function.edk2inf",
              "match": "\\b[a-zA-Z0-9_]+\\b"
            }
          ]
        },
        {
          "begin": "^[ \\t]*(INF_VERSION|BASE_NAME|FILE_GUID|MODULE_TYPE|UEFI_SPECIFICATION_VERSION|PI_SPECIFICATION_VERSION|LIBRARY_CLASS|BUILD_NUMBER|VERSION_STRING|PCD_IS_DRIVER|SHADOW|CUSTOM_MAKEFILE|DPX_SOURCE|SPEC|MODULE_UNI_FILE|UEFI_HII_RESOURCE_SECTION|PEI_PCD_DRIVER|DXE_PCD_DRIVER|PCI_VENDOR_ID|PCI_DEVICE_ID|PCI_CLASS_CODE|PCI_REVISION|PCI_COMPRESS|EDK_RELEASE_VERSION)[ \\t]*(=)[ \\t]*",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.edk2inf"
            },
            "2": {
              "name": "punctuation.separator.equals.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "#moduleType"
            },
            {
              "include": "#constants_and_data"
            }
          ]
        }
      ]
    },
    "macro": {
      "patterns": [
        {
          "begin": "^[ \\t]*\\b(DEFINE)\\b[ \\t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \\t]*(=)[ \\t]*",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.define.edk2inf"
            },
            "2": {
              "name": "variable.other.macro.edk2inf"
            },
            "3": {
              "name": "keyword.operator.assignment.edk2inf"
            }
          },
          "patterns": [
            {
              "include": "#constants_and_data"
            }
          ]
        }
      ]
    },
    "moduleType": {
      "patterns": [
        {
          "name": "variable.language.edk2inf",
          "match": "\\b(BASE|SEC|PEI_CORE|PEIM|DXE_CORE|DXE_DRIVER|SMM_CORE|DXE_RUNTIME_DRIVER|DXE_SAL_DRIVER|DXE_SMM_DRIVER|UEFI_DRIVER|UEFI_APPLICATION|USER_DEFINED)\\b"
        }
      ]
    },
    "binary_file_type": {
      "patterns": [
        {
          "name": "variable.language.edk2inf",
          "match": "\\b(UNI_UI|UI|UNI_VER|VER|ACPI|ASL|PE32|PIC|FV|PEI_DEPEX|DXE_DEPEX|SMM_DEPEX|TE|BIN|RAW|COMPAT16|DISPOSABLE|LIB)\\b"
        }
      ]
    },
    "constants_and_data": {
      "patterns": [
        {
          "name": "constant.numeric.guid.edk2inf",
          "match": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\b"
        },
        {
          "include": "#macro_expression"
        },
        {
          "include": "#string_expression"
        },
        {
          "include": "#moduleType"
        },
        {
          "name": "keyword.operator.logical.pipe.edk2inf",
          "match": "\\|"
        },
        {
          "name": "constant.numeric.version.edk2inf",
          "match": "\\b[0-9]+(\\.[0-9]+)+\\b"
        },
        {
          "name": "constant.language.boolean.edk2inf",
          "match": "\\b(TRUE|FALSE)\\b"
        },
        {
          "name": "keyword.operator.logical.edk2inf",
          "match": "\\b(AND|OR|NOT|SOR)\\b"
        },
        {
          "name": "constant.numeric.hex.edk2inf",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.edk2inf",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "macro_expression": {
      "name": "string.interpolated.edk2inf",
      "begin": "(\\$\\()",
      "end": "(\\))",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.variable.begin.edk2inf"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.variable.end.edk2inf"
        }
      },
      "patterns": [
        {
          "name": "variable.other.edk2inf",
          "match": "[a-zA-Z0-9_]"
        }
      ]
    },
    "string_expression": {
      "name": "string.quoted.double.edk2inf",
      "begin": "(L)?\"",
      "end": "\"",
      "beginCaptures": {
        "1": {
          "name": "storage.type.string.edk2inf"
        },
        "2": {
          "name": "punctuation.definition.string.begin.edk2inf"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.edk2inf"
        }
      }
    },
    "compiler_flag": {
      "patterns": [
        {
          "name": "meta.preprocessor.macro.edk2inf",
          "match": "(-D|/D)[ \\t]*([a-zA-Z0-9_]+)",
          "captures": {
            "1": {
              "name": "keyword.control.compiler.flag.edk2inf"
            },
            "2": {
              "name": "variable.other.macro.edk2inf"
            }
          }
        }
      ]
    }
  }
}
