          "match": "\\b(SEC|PEI_CORE|PEIM|FREEFORM|PEI_DXE_COMBO|DRIVER|DXE_CORE|APPLICATION|SMM_CORE|SMM|MM_CORE_STANDALONE|MM_STANDALONE|RAW|NON_FFS_FILE|FV_IMAGE)\\b",
