        },
        {
          "include": "source.edk2cmn#decimal_numbers"
        },
        {
          "include": "source.edk2cmn#hex_numbers"
        }
      ]
    },
    "rule_secion_keyword": {
      "match": "\\b(FILE|NON_FFS_FILE|RAW|FV_IMAGE|SEC|PEI_CORE|PEIM|PEI_DXE_COMBO|FREEFORM|DRIVER|DXE_CORE|APPLICATION|SMM_CORE|SMM|MM_CORE_STANDALONE|MM_STANDALONE|RELOCS_STRIPPED|RELOCS_RETAINED|Fixed|Checksum|Align|COMPAT16|PE32|PIC|TE|FV_IMAGE|RAW|DXE_DEPEX|UI|PEI_DEPEX|SMM_DEPEX|VERSION|SUBTYPE_GUID|COMPRESS|PI_STD|PI_NONE|GUIDED|PROCESSING_REQUIRED|AUTH_STATUS_VALID|EXTRA_HEADER_SIZE|BIN|RAW|ACPI|ASL|Optional|STRING|BUILD_NUM|FvBaseAddress|FvAlignment|MEMORY_MAPPED|LOCK_CAP|LOCK_STATUS|WRITE_LOCK_CAP|WRITE_LOCK_STATUS|WRITE_ENABLED_CAP|WRITE_DISABLED_CAP|WRITE_STATUS|STICKY_WRITE|WRITE_POLICY_RELIABLE|READ_LOCK_CAP|READ_LOCK_STATUS|READ_ENABLED_CAP|READ_DISABLED_CAP|READ_STATUS|APRIORI PEI|APRIORI DXE)\\b",
      "name": "keyword.control.edk2fdf"
    },
    "pci_optionrom_secion_keyword": {
      "match": "\\b(INF|USE|PCI_VENDOR_ID|PCI_CLASS_CODE|PCI_DEVICE_ID|PCI_REVISION|PCI_COMPRESS|FILE|EFI|BIN)\\b",
      "name": "keyword.control.edk2fdf"
    }
  }
}
