    "section_dot_rule": {
      "begin": "\\G",
      "end": "\\]",
      "patterns": [
        {
          "match": "(?i:\\b(FD|FV|Capsule|FmpPayload|Rules|OptionRom)\\b)",
          "name": "keyword.control.edk2fdf"
        },
        {
          "match": "\\.[ \\t]+|\\.(?=\\])",
          "name": "invalid.illegal.whitespace.edk2fdf"
        },
        {
          "match": "\\.",
          "name": "punctuation.separator.dot.edk2fdf"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.edk2fdf"
        },
        {
          "match": "(?<=[.|])[a-zA-Z0-9_]+\\b",
          "name": "variable.parameter.edk2fdf"
        },
        {
          "match": "\"[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*\"",
          "name": "string.quoted.double.edk2fdf"
        },
        {
          "include": "source.edk2cmn#FieldSeparator"
        }
      ]
    },
    "define_statements": {
      "begin": "^[ \\t]*(FDF_SPECIFICATION|FDF_VERSION)[ \\t]*(=)[ \\t]*",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.edk2fdf"
        },
        "2": {
          "name": "punctuation.separator.equals.edk2fdf"
        }
      },
      "patterns": [
        {
          "include": "source.edk2cmn#Comment"
        },
        {
          "include": "source.edk2cmn#version_expression"
        },
        {
          "include": "source.edk2cmn#hex_numbers"
        },
        {
          "include": "source.edk2cmn#decimal_numbers"
        }
      ]
    },
    "TokenStatements": {
      "begin": "^[ \\t]*(BaseAddress|Size|ErasePolarity|BlockSize|NumBlocks)[ \\t]*(=)[ \\t]*",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.edk2fdf"
        },
        "2": {
          "name": "punctuation.separator.equals.edk2fdf"
