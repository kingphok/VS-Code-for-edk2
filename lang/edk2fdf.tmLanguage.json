    "RegionLayout": {
      "begin": "^[ \\t]*(?=[a-zA-Z_][a-zA-Z0-9_.]*[ \\t]*\\|[ \\t]*[a-zA-Z_])",
      "end": "$",
      "patterns": [
        {
          "include": "source.edk2cmn#Comment"
        },
        {
          "include": "source.edk2cmn#PcdName_PcdFieldName"
        }
      ]
    },
    "InfStatements": {
      "begin": "^[ \\t]*\\b(INF)\\b(?:[ \\t]+(USE|RuleOverride|VERSION|UI)[ \\t]*(=))?",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.edk2fdf"
        },
        "2": {
          "name": "keyword.control.edk2fdf"
        },
        "3": {
          "name": "punctuation.separator.equals.edk2fdf"
        }
      },
      "patterns": [
        {
          "include": "source.edk2cmn#Comment"
