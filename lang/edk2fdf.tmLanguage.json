          "name": "keyword.control.edk2fdf"
        }
      },
      "patterns": [
        {
          "include": "source.edk2cmn#Comment"
        }
      ]
    },
    "FmpFileStatement": {
      "begin": "^[ \\t]*\\b(FILE)\\b[ \\t]+\\b(DATA)\\b",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.edk2fdf"
        },
        "2": {
          "name": "keyword.control.edk2fdf"
        }
      },
      "patterns": [
        {
          "include": "source.edk2cmn#Comment"
