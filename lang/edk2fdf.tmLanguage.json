        {
          "match": "\\b(Align|BUILD_NUM|COMPRESS|GUIDED|VERSION|UI|FV_IMAGE|BUILD_NUM|SUBTYPE_GUID|COMPAT16|PE32|PIC|TE|RAW|DXE_DEPEX|SMM_DEPEX|PEI_DEPEX|COMPRESS|GUIDED|PROCESSING_REQUIRED|AUTH_STATUS_VALID|EXTRA_HEADER_SIZE|PEI_DEPEX_EXP|DXE_DEPEX_EXP|SMM_DEPEX_EXP)\\b",
          "name": "keyword.control.edk2fdf"
        }
      ]
    },
    "UefiTokens": {
      "begin": "^[ \\t]*(CAPSULE_GUID|CAPSULE_HEADER_SIZE|CAPSULE_FLAGS|CAPSULE_HEADER_INIT_VERSION|FV|FD)[ \\t]*(=)[ \\t]*",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.edk2fdf"
        },
        "2": {
          "name": "punctuation.separator.equals.edk2fdf"
