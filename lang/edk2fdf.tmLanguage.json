          "include": "source.edk2cmn#MACROVAL"
        }
      ]
    },
    "ExtendedFvEntry": {
      "begin": "^[ \\t]*(FV_EXT_ENTRY_TYPE)\\b",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.edk2fdf"
        }
      },
      "patterns": [
        {
          "match": "\\b(TYPE|FILE|DATA)\\b",
          "name": "keyword.other.edk2fdf"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.edk2fdf"
        },
        {
          "include": "source.edk2cmn#Comment"
        },
        {
          "include": "source.edk2cmn#hex_numbers"
        },
        {
          "include": "source.edk2cmn#MACROVAL"
        }
      ]
    },
    "FvStatements": {
      "begin": "^[ \\t]*(BlockSize|NumBlocks|FvBaseAddress|FvForceRebase|FvAlignment|MEMORY_MAPPED|LOCK_CAP|LOCK_STATUS|WRITE_LOCK_CAP|WRITE_LOCK_STATUS|WRITE_ENABLED_CAP|WRITE_DISABLED_CAP|WRITE_STATUS|STICKY_WRITE|WRITE_POLICY_RELIABLE|READ_LOCK_CAP|READ_LOCK_STATUS|READ_ENABLED_CAP|READ_DISABLED_CAP|READ_STATUS|WEAK_ALIGNMENT|ERASE_POLARITY|FileSystemGuid|VariableSignatureGuid|VariabeRegionSize|FtwWorkingSpaceSize|FtwSpareSpaceSize|FvNameGuid|FvUsedSizeEnable|FvNameString)[ \\t]*(=)[ \\t]*",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.edk2fdf"
        },
        "2": {
          "name": "punctuation.separator.equals.edk2fdf"
        }
      },
