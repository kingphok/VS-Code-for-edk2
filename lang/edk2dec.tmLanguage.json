{
  "name": "EDK2 DEC",
  "scopeName": "source.edk2dec",
  "fileTypes": [
    "dec"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#section"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.edk2dec",
          "match": "#.*$"
        }
      ]
    },
    "section": {
      "patterns": [
        {
          "name": "entity.name.section.edk2dec",
          "match": "^\\s*\\[[a-zA-Z0-9_,\\.\\| ]+\\]"
        }
      ]
    }
  }
}
