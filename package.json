{
  "name": "VS-Code-for-edk2",
  "displayName": "VS-Code-for-edk2",
  "description": "VS Code Extension for reading EDK2 Language easily.",
  "version": "0.0.1",
  "publisher": "your-publisher-id",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "edk2dec",
        "aliases": [
          "EDK2 DEC"
        ],
        "extensions": [
          ".dec"
        ],
        "configuration": "./lang/edk2dec.configuration.json"
      },
      {
        "id": "edk2dsc",
        "aliases": [
          "EDK2 DSC"
        ],
        "extensions": [
          ".dsc",
          ".dsc.inc",
          ".template"
        ],
        "configuration": "./lang/edk2dsc.configuration.json"
      },
      {
        "id": "edk2fdf",
        "aliases": [
          "EDK2 FDF"
        ],
        "extensions": [
          ".fdf",
          ".fdf.inc"
        ],
        "configuration": "./lang/edk2fdf.configuration.json"
      },
      {
        "id": "edk2idf",
        "aliases": [
          "EDK2 IDF"
        ],
        "extensions": [
          ".idf"
        ],
        "configuration": "./lang/edk2idf.configuration.json"
      },
      {
        "id": "edk2inf",
        "aliases": [
          "EDK2 INF"
        ],
        "extensions": [
          ".inf"
        ],
        "configuration": "./lang/edk2inf.configuration.json"
      },
      {
        "id": "edk2uni",
        "aliases": [
          "EDK2 UNI"
        ],
        "extensions": [
          ".uni",
          ".UNI"
        ],
        "configuration": "./lang/edk2uni.configuration.json"
      },
      {
        "id": "edk2vfr",
        "aliases": [
          "EDK2 VFR"
        ],
        "extensions": [
          ".vfr",
          ".vfi",
          ".hfr"
        ],
        "configuration": "./lang/edk2vfr.configuration.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.edk2cmn",
        "path": "./lang/edk2cmn.tmLanguage.json"
      },
      {
        "language": "edk2dec",
        "scopeName": "source.edk2dec",
        "path": "./lang/edk2dec.tmLanguage.json"
      },
      {
        "language": "edk2dsc",
        "scopeName": "source.edk2dsc",
        "path": "./lang/edk2dsc.tmLanguage.json"
      },
      {
        "language": "edk2fdf",
        "scopeName": "source.edk2fdf",
        "path": "./lang/edk2fdf.tmLanguage.json"
      },
      {
        "language": "edk2idf",
        "scopeName": "source.edk2idf",
        "path": "./lang/edk2idf.tmLanguage.json"
      },
      {
        "language": "edk2inf",
        "scopeName": "source.edk2inf",
        "path": "./lang/edk2inf.tmLanguage.json"
      },
      {
        "language": "edk2uni",
        "scopeName": "source.edk2uni",
        "path": "./lang/edk2uni.tmLanguage.json"
      },
      {
        "language": "edk2vfr",
        "scopeName": "source.edk2vfr",
        "path": "./lang/edk2vfr.tmLanguage.json"
      }
    ]
  }
}
