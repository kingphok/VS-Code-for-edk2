{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "moduleResolution": "bundler",
        "ignoreDeprecations": "6.0",
        "outDir": "./out",
        "rootDir": "./src-ts",
        "sourceMap": true,
        "strict": false,
        "skipLibCheck": true
    },
    "include": [
        "src-ts/**/*"
    ],
    "exclude": [
        "node_modules",
        "out"
    ]
}
