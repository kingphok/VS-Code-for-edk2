#==============================================================================
#
#  ## @file
#  Syntax Extension Test DEC File for EDK II v1.27.
#
#==============================================================================

[Defines]
  DEC_SPECIFICATION              = 0x0001001B
  PACKAGE_NAME                   = TestPkg
  PACKAGE_GUID                   = 9A6A1234-ABCD-4321-8888-A1B2C3D4E5F6
  PACKAGE_VERSION                = 1.00
  PACKAGE_UNI_FILE               = TestPkg.uni

  DEFINE SPEC_REVISION           = 1.27
  DEFINE SECTOR_SIZE             = 0x200
  DEFINE OUTPUT_NAME             = L"SamplePkg"

[Includes]
  DEFINE MDE = Include/Library

  Include/Library
  $(MDE)

[Includes.common]
  DEFINE MDE_LIBRARY = MdeLibrary

  Include
  Include/Library

[Includes.IA32, Includes.X64, Includes.ARM, Includes.AARCH64]
  Include/Cpu/Arm

[LibraryClasses.common]
  DEFINE MDE = Include/Library
  TestLib|Include/Library/TestLib.h
  MdeLib|$(MDE)/TestLib.h

[LibraryClasses]

[LibraryClasses.IA32]
  TestCpuLib|Include/Library/Ia32/TestCpuLib.h

[LibraryClasses.X64]

[Guids.common]
  gTestPkgTokenSpaceGuid         = { 0x11223344, 0x5566, 0x7788, { 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF, 0x00 } }
  gSamplePkgTokenSpaceGuid       = { 0x22334455, 0x6677, 0x8899, { 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF, 0x00, 0x11 } }

[Protocols.common.Private]

[Protocols.common]
  gTestProtocolGuid              = { 0x33445566, 0x7788, 0x8899, { 0xBB, 0xCC, 0xDD, 0xEE, 0xFF, 0x00, 0x11, 0x22 } }


[Ppis.common]
  gTestPpiGuid                   = { 0x44556677, 0x8899, 0x99AA, { 0xCC, 0xDD, 0xEE, 0xFF, 0x00, 0x11, 0x22, 0x33 } }

[PcdsFixedAtBuild.common]
  gTestPkgTokenSpaceGuid.PcdFixedUINT8|255|UINT8|0x00000001
  gTestPkgTokenSpaceGuid.PcdFixedUINT16|0x1234|UINT16|0x00000002
  gTestPkgTokenSpaceGuid.PcdFixedUINT32|0x12345678|UINT32|0x00000003
  gTestPkgTokenSpaceGuid.PcdFixedUINT64|0x1234567890ABCDEF|UINT64|0x00000004
  gTestPkgTokenSpaceGuid.PcdFixedBool|TRUE|BOOLEAN|0x00000005
  gTestPkgTokenSpaceGuid.PcdFixedString|"Test.logo"|VOID*|0x00000006
  gTestPkgTokenSpaceGuid.PcdFixedString|"Test"|VOID*|0x00000006
  gTestPkgTokenSpaceGuid.PcdFixedUnicodeString|L"Test"|VOID*|0x00000007
  gSamplePkgTokenSpaceGuid.PcdFixedSampleInt32|$(SECTOR_SIZE)|UINT32|0x00000002
  gSamplePkgTokenSpaceGuid.PcdFixedSampleString|$(OUTPUT_NAME)|VOID*|0x00000003

[PcdsFeatureFlag.common]
  gTestPkgTokenSpaceGuid.PcdFeatureEnable|FALSE|BOOLEAN|0x00000007

[PcdsPatchableInModule.common]
  gTestPkgTokenSpaceGuid.PcdPatchInt32|0x00000000|UINT32|0x00000008

[PcdsDynamic.X64, PcdsDynamic.ARM]
  gTestPkgTokenSpaceGuid.PcdDynamicInt32|0x00000000|UINT32|0x00000009

[PcdsDynamic.common]
  gTestPkgTokenSpaceGuid.PcdDynamicInt32|0x00000000|UINT32|0x00000009

[PcdsFixedAtBuild, PcdsPatchableInModule, PcdsDynamic, PcdsDynamicEx]
  gTestPkgTokenSpaceGuid.PcdDynamicExInt32|0x00000000|UINT32|0x0000000A

[UserExtensions.TianoCore."ExtraFiles"]
  TestPkgExtra.uni
  Test.logo


# Incorrct coding in dec file
[Define.IA32]
[Defines.X64]
[Include]
[Includes.]
[Includes. ]
[Includes. IA32, Includes.X64]
[Includes.IA32, Includes. X64]
